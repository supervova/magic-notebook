---
import type { Locale } from '../i18n/config';
import '../styles/main.css';

interface Props {
  noindex?: boolean;
  analytics?: boolean;
  alternates?: Partial<Record<Locale, string>>;
  bodyClass?: string;
  description: string;
  lang: Locale;
  title: string;
}

const { title, description, lang, bodyClass, alternates, noindex = false, analytics = true } = Astro.props;
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
const ogImageUrl = Astro.site ? new URL('/assets/img/magic-notebook.jpg', Astro.site).toString() : undefined;
const localeToOgLocale = {
  en: 'en_US',
  ru: 'ru_RU',
  de: 'de_DE',
  es: 'es_ES',
  fr: 'fr_FR',
  it: 'it_IT',
  pt: 'pt_PT',
  uk: 'uk_UA',
  ja: 'ja_JP',
  ko: 'ko_KR',
  zh: 'zh_CN',
} as const;
const alternateUrls = Astro.site
  ? Object.entries(alternates ?? {}).map(([locale, path]) => ({
      href: new URL(path, Astro.site).toString(),
      locale,
    }))
  : [];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {noindex && <meta name="referrer" content="no-referrer" />}

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={localeToOgLocale[lang]} />
    <meta name="twitter:card" content="summary_large_image" />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {alternateUrls.map(({ href, locale }) => <link rel='alternate' hreflang={locale} href={href} />)}
    {alternateUrls.length > 0 && <link rel='alternate' hreflang='x-default' href={alternateUrls[0]?.href} />}

    <link rel="icon" href="https://magic-notebook.com/favicon.ico" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <!-- Google Analytics -->
    {analytics && <script is:inline src="https://www.googletagmanager.com/gtag/js?id=G-LLY58MEX1Q" async></script>}

    {analytics && <script is:inline>
      window.dataLayer = window.dataLayer || [];

      function gtag() {
        dataLayer.push(arguments);
      }

      gtag('js', new Date());
      gtag('config', 'G-LLY58MEX1Q');
    </script>}
  </head>

  <body class={bodyClass}>
    <slot />
    <script src="../js/main.js"></script>
  </body>
</html>
