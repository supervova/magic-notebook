---
import { appLinks } from '../config/app-links';
import SiteFooter from '../components/layout/site-footer.astro';
import SiteHeader from '../components/layout/site-header.astro';
import imgMacosDoc from '../assets/img/pages/whats-new/2026-08-18-macos-doc.png';
import imgMacosSettings from '../assets/img/pages/whats-new/2026-08-18-macos-settings.png';
import imgWindowsDoc from '../assets/img/pages/whats-new/2026-08-18-windows-doc.png';
import imgWindowsSettings from '../assets/img/pages/whats-new/2026-08-18-windows-settings.png';
import type { Locale } from '../i18n/config';
import type { commonDictionaries } from '../i18n/config';
import type { WhatsNewDictionary } from '../i18n/pages/whats-new/types';
import { getLocalizedAlternates } from '../i18n/utils';
import BaseLayout from '../layouts/base.astro';

import '../styles/pages/whats-new.css';

interface Props {
  locale: Locale;
  commonDictionary: (typeof commonDictionaries)[Locale];
  pageDictionary: WhatsNewDictionary;
}

const { locale, commonDictionary, pageDictionary } = Astro.props;

const baseCopy = commonDictionary.base;
const navCopy = commonDictionary.nav;
const macosDownloadHref = appLinks.downloads.macos;
const windowsDownloadHref = appLinks.downloads.windows;
const releaseImageSources = {
  '2026-08-18-macos-doc': imgMacosDoc,
  '2026-08-18-macos-settings': imgMacosSettings,
  '2026-08-18-windows-doc': imgWindowsDoc,
  '2026-08-18-windows-settings': imgWindowsSettings,
};
---

<BaseLayout
  alternates={getLocalizedAlternates('whats-new')}
  bodyClass='page-whats-new'
  title={pageDictionary.meta.title}
  description={pageDictionary.meta.desc}
  lang={locale}
>
  <SiteHeader
    baseCopy={baseCopy}
    locale={locale}
    macosDownloadHref={macosDownloadHref}
    navCopy={navCopy}
    showBanner={true}
    windowsDownloadHref={windowsDownloadHref}
  />

  <main class='wrapper'>
    <header class='page-header col-2/3'>
      <h1>{pageDictionary.page.title}</h1>

      <ul class='list-unstyled'>
        {
          pageDictionary.legend.map((tag) => (
            <li>
              <span class={`tag tag-${tag.tone}`} aria-label={tag.label}>
                {tag.shortLabel}
              </span>
              {tag.label}
            </li>
          ))
        }
      </ul>
    </header>

    <div class='release-notes'>
      {
        pageDictionary.releases.map((release) => (
          <section class='release-note col-1/2'>
            <h2>
              {release.date}
              {' '}
              <span class='text-02'>
                - {pageDictionary.page.versionLabel} {release.version}
              </span>
            </h2>

            <ul class='list-tagged'>
              {
                release.items.map((item) => {
                  const tag = pageDictionary.legend.find(({ tone }) => tone === item.tone);

                  if (!tag) {
                    return null;
                  }

                  return (
                    <li>
                      <span class={`tag tag-${tag.tone}`} aria-label={tag.label}>
                        {tag.shortLabel}
                      </span>
                      <span class='desc'>{item.text}</span>
                    </li>
                  );
                })
              }
            </ul>

            {
              release.images?.map((image) => {
                const source = releaseImageSources[image];
                const marginClass = image === '2026-08-18-windows-settings' ? 'mt-2lh' : 'mt-3';

                return <img class={marginClass} src={source.src} width={source.width} height={source.height} alt='' loading='lazy' decoding='async' />;
              })
            }
          </section>
        ))
      }
    </div>
  </main>

  <SiteFooter baseCopy={baseCopy} locale={locale} navCopy={navCopy} />
</BaseLayout>
